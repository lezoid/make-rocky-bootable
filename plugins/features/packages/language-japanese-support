[meta]
label = Japanese Language Support
description = 日本語パックと日本語ロケールをインストールする
check = true
order = 20

[packages]
langpacks-ja
glibc-langpack-ja

[post]
# Install Japanese language packages
dnf -y install langpacks-ja glibc-langpack-ja

# Set system locale to Japanese
echo "LANG=ja_JP.UTF-8" > /etc/locale.conf

# Set keyboard layout to Japanese 109
echo "KEYMAP=jp106" > /etc/vconsole.conf
localectl set-x11-keymap jp

# Set timezone to Asia/Tokyo
ln -snf /usr/share/zoneinfo/Asia/Tokyo /etc/localtime
echo "Asia/Tokyo" > /etc/timezone
