# Power management: disable screen dim/off and screen lock
cat > /etc/skel/.config/powerdevilrc << 'POWERDEVIL_EOF'
[AC][Display]
DimDisplayIdleTimeoutSec=-1
DimDisplayWhenIdle=false
TurnOffDisplayIdleTimeoutSec=-1
TurnOffDisplayWhenIdle=false
POWERDEVIL_EOF

cat > /etc/skel/.config/kscreenlockerrc << 'KSCREENLOCKER_EOF'
[Daemon]
Autolock=false
LockOnResume=false
Timeout=0
KSCREENLOCKER_EOF

{% if extra_user %}
# RDP server configuration (user-specific paths)
cat > /etc/skel/.config/krdpserverrc << 'KRDPSERVERRC_EOF'
[General]
Autostart=true
Certificate=/home/{{ extra_user.name }}/.local/share/krdpserver/krdp.crt
CertificateKey=/home/{{ extra_user.name }}/.local/share/krdpserver/krdp.key
Users={{ extra_user.name }}
KRDPSERVERRC_EOF

# Generate TLS certificate for krdpserver
openssl req -x509 -newkey rsa:2048 \
  -keyout /etc/skel/.local/share/krdpserver/krdp.key \
  -out /etc/skel/.local/share/krdpserver/krdp.crt \
  -days 3650 -nodes -subj '/CN=make-rocky-bootable' 2>/dev/null
chmod 600 /etc/skel/.local/share/krdpserver/krdp.key

# krdpserver systemd autostart symlinks
ln -sf /usr/lib/systemd/user/app-org.kde.krdpserver.service \
  /etc/skel/.config/systemd/user/plasma-krdp_server.service
ln -sf /usr/lib/systemd/user/app-org.kde.krdpserver.service \
  /etc/skel/.config/systemd/user/plasma-workspace.target.wants/app-org.kde.krdpserver.service

# krdpserver systemd override: username = RDP password
cat > /etc/skel/.config/systemd/user/app-org.kde.krdpserver.service.d/override.conf << 'KRDPOVERRIDE_EOF'
[Service]
ExecStart=
ExecStart=/usr/bin/krdpserver -u %u -p %u
KRDPOVERRIDE_EOF

# sudoers: allow wheel group to restart SDDM without password
cat > /etc/sudoers.d/sddm-restart << 'SDDMSUDOERS_EOF'
%wheel ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart sddm
SDDMSUDOERS_EOF
chmod 440 /etc/sudoers.d/sddm-restart

# Desktop shortcuts
cat > '/etc/skel/Desktop/Restart RDP.desktop' << 'RDPDESKTOP_EOF'
[Desktop Entry]
Type=Application
Name=RDP サーバー再起動
Name[en]=Restart RDP Server
Exec=systemctl --user restart app-org.kde.krdpserver.service
Icon=network-server
Terminal=false
RDPDESKTOP_EOF

cat > '/etc/skel/Desktop/Restart KDE.desktop' << 'KDEDESKTOP_EOF'
[Desktop Entry]
Type=Application
Name=KDE セッション再起動
Name[en]=Restart KDE Session
Exec=sudo systemctl restart sddm
Icon=system-reboot
Terminal=false
KDEDESKTOP_EOF

for f in 'Restart RDP.desktop' 'Restart KDE.desktop'; do
    chmod +x "/etc/skel/Desktop/$f"
    cp "/etc/skel/Desktop/$f" "/etc/skel/デスクトップ/$f"
    chmod +x "/etc/skel/デスクトップ/$f"
done

# SDDM autologin
mkdir -p /etc/sddm.conf.d
cat > /etc/sddm.conf.d/autologin.conf << 'SDDMAUTOLOGIN_EOF'
[Autologin]
User={{ extra_user.name }}
Session=plasma
SDDMAUTOLOGIN_EOF
{% endif %}

# XDP portal permission: autostart script (runs once at first KDE login, then removes itself)
cat > /usr/local/bin/setup-krdp-permission.sh << 'XDPSCRIPT_EOF'
#!/bin/bash
gdbus call \
  --session \
  --dest org.freedesktop.impl.portal.PermissionStore \
  --object-path /org/freedesktop/impl/portal/PermissionStore \
  --method org.freedesktop.impl.portal.PermissionStore.Set \
  'kde-authorized' true 'remote-desktop' "{'org.kde.krdpserver': ['yes']}" "<''>" && \
  rm -f "$HOME/.config/autostart/setup-krdp-permission.desktop"
XDPSCRIPT_EOF
chmod +x /usr/local/bin/setup-krdp-permission.sh

cat > /etc/skel/.config/autostart/setup-krdp-permission.desktop << 'XDPAUTOSTART_EOF'
[Desktop Entry]
Type=Application
Name=Setup KRDP Permission
Exec=/usr/local/bin/setup-krdp-permission.sh
Hidden=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
XDPAUTOSTART_EOF

{% else %}
##############################################################
###              Rocky 7/8/9: XFCE + XRDP                 ###
##############################################################
## Add GUI Packages
# Enable EPEL repository
dnf -y install epel-release

# Install additional packages from EPEL
dnf -y install langpacks-ja glibc-langpack-ja ibus-mozc firefox chromium xrdp

# Install XFCE desktop environment
dnf -y groupinstall "xfce"

## gdm autologin enable
#sed -i '1i auth sufficient pam_succeed_if.so user ingroup nopasswdlogin' /etc/pam.d/gdm-password
#groupadd nopasswdlogin
#usermod -aG nopasswdlogin Administrator

## gdm autologin setting
#bash -c 'cat <<EOL > /etc/gdm/custom.conf
## GDM configuration storage
#
#[daemon]
#AutomaticLogin=Administrator
#AutomaticLoginEnable=True
# Uncomment the line below to force the login screen to use Xorg
#WaylandEnable=false
#
#[security]
#
#[xdmcp]
#
#[chooser]
#
#[debug]
# Uncomment the line below to turn on debugging
#Enable=true
#EOL'

## create xinit files for skel, root
for path in /etc/skel /root; do
    echo "exec /usr/bin/xfce4-session" > $path/.Xclients
    echo "exec /usr/bin/xfce4-session" > $path/.xinitrc
    chmod +x $path/.Xclients
    chmod +x $path/.xinitrc
done

## gdm default session for xfce with correct Icon paths
for account in root; do
    icon_path="/home/$account/.face"
    [[ "$account" == "root" ]] && icon_path="/root/.face"

    sudo bash -c "cat <<EOL > /etc/accountsservice/user-templates/$account
# This file contains defaults for new users. To edit, first
# copy it to /etc/accountsservice/user-templates and make changes
# there

[com.redhat.AccountsServiceUser.System]
id=\"rocky\"
version-id=\"9.4\"

[User]
Session=xfce
Icon=$icon_path
SystemAccount=true
EOL"
done

## gdm session settings for root and Users
for useraccount in root; do
    sudo bash -c "cat <<EOL > /var/lib/AccountsService/users/$useraccount
[User]
XSession=xfce
EOL"
done

## Ibus setting
for user in root; do
    bashrc_path="/home/$user/.bashrc"
    [[ "$user" == "root" ]] && bashrc_path="/root/.bashrc"

    cat <<EOL >> $bashrc_path

# IBus settings for input method
export GTK_IM_MODULE=ibus
export XMODIFIERS=@im=ibus
export QT_IM_MODULE=ibus
EOL
done

# Set graphical target as default
systemctl set-default graphical

# Enable and start xrdp
systemctl enable xrdp --now

# Open port 3389 for XRDP (TCP)
systemctl enable firewalld
systemctl start firewalld
firewall-offline-cmd --add-port=3389/tcp
{% endif %}

##############################################################
###                      End Desktop Config                ###
##############################################################

{% endif %}
{% if extra_user %}
# Create general user
useradd {{ extra_user.name }}
echo "{{ extra_user.name }}:{{ extra_user.password }}" | chpasswd
{% if extra_user.sudoer %}
usermod -aG wheel {{ extra_user.name }}
{% endif %}
{% endif %}

{% if extra_user and extra_user.disable_root_ssh %}
# Disable root SSH login
sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config
{% else %}
# Allow SSH login as root
sed -i 's/#PermitRootLogin yes/PermitRootLogin yes/' /etc/ssh/sshd_config
sed -i 's/^#PermitRootLogin prohibit-password/PermitRootLogin yes/' /etc/ssh/sshd_config
{% endif %}
systemctl restart sshd
{% if not gui %}

# Enable firewalld
systemctl enable firewalld
systemctl start firewalld
{% endif %}

# Create a systemd service for running the startup script once at boot
cat << EOF > /etc/systemd/system/firstboot-startup.service
[Unit]
Description=Run startup.sh script on first boot
After=network.target

[Service]
Type=oneshot
ExecStart=/bin/bash -x /run/initramfs/live/scripts/startup.sh
ExecStartPost=/bin/rm -f /etc/systemd/system/firstboot-startup.service
StandardOutput=append:/var/log/firstboot-startup.log
StandardError=append:/var/log/firstboot-startup.log

[Install]
WantedBy=multi-user.target
EOF

# Enable the firstboot service
systemctl enable firstboot-startup.service

# Cleanup operations
rm -f /core*
rm -f /var/lib/rpm/__db*
rm -f /var/lib/systemd/random-seed
rm -f /etc/machine-id
touch /etc/machine-id
# Log disk usage at end of post script
df -h

{% if not debug %}
rm -f /root/anaconda-ks.cfg /root/ks-post.log /root/original-ks.cfg
{% endif %}

%end
shutdown
