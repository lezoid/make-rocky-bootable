#version=RHEL9 {{ 'UEFI' if uefi else 'MBR' }}{% if gui %} with GUI{% endif %}
# System language
{% if gui %}
lang ja_JP.UTF-8
{% else %}
lang en_US.UTF-8
{% endif %}

# Keyboard layout
keyboard jp

# Timezone settings
timezone Asia/Tokyo --utc

# root user plain text password settings
rootpw --plaintext {{ root_password }}

# Network settings
network --bootproto=dhcp --device=link --activate

# Disable SELinux
selinux --permissive

{% if version <= 9 %}
# Authentication information
auth --useshadow --passalgo=sha512
{% endif %}

# Disk partitioning
{% if uefi %}
bootloader --location=none
clearpart --all --initlabel
reqpart
part / --size=6656 --grow
{% else %}
clearpart --all --initlabel
part / --fstype="xfs" --grow --size=8192
bootloader --location=mbr
{% endif %}

# Package selection
%packages
## --Required LiveBoot Packages ---
dracut-live
memtest86+
syslinux
*-logos
firewalld
{% if uefi %}
# Add UEFI Support
shim
grub2
grub2-efi
grub2-efi-*-cdboot
efibootmgr
{% endif %}
## ---------Add Packages-----------
vi
bash-completion
{% if gui %}
langpacks-ja
glibc-langpack-ja
{% endif %}
## -------Remove Packages----------
-iwl*-firmware
%end

# Post script: Configure services and system settings inside the guest
%post --log=/root/ks-post.log

# Log disk usage at start of post script
df -h

# Configure dnf: fastestmirror + timeout settings
cat << 'EOF' >> /etc/dnf/dnf.conf
fastestmirror=True
minrate=5000
timeout=30
retries=3
EOF

{% if gui %}

##############################################################
###                       Desktop Config                   ###
##############################################################
## Setting Desktop Users (Administrator)
#useradd Administrator
#usermod -aG wheel Administrator

## Set Administrator password
#echo "Administrator:password" | chpasswd
#Encrypt Version
#echo "Administrator:PASSWORD_HASH" | chpasswd --encrypted

{% if version >= 10 %}
##############################################################
###                  Rocky 10: KDE Plasma                  ###
##############################################################
# Enable EPEL repository
dnf -y install epel-release

# Enable CRB repository
dnf config-manager --set-enabled crb
dnf clean all

# Install KDE Plasma Workspaces
dnf -y groupinstall "KDE Plasma Workspaces"

# Install additional packages
dnf -y install firefox

# Enable SDDM display manager
systemctl enable sddm

# Set graphical target as default
systemctl set-default graphical

# Enable firewalld and open RDP port
systemctl enable firewalld
firewall-offline-cmd --add-port=3389/tcp

# Add Flatpak flathub repository
flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo

# Install Fcitx5 + Mozc via Flatpak
flatpak install -y flathub org.fcitx.Fcitx5 org.fcitx.Fcitx5.Addon.Mozc

# Install RPM Fusion and ffmpeg for H264 RDP encoding
dnf install -y --nogpgcheck https://mirrors.rpmfusion.org/free/el/rpmfusion-free-release-10.noarch.rpm
dnf install -y --allowerasing ffmpeg

# /etc/skel/ directory structure for KDE + Fcitx5 + RDP
mkdir -p /etc/skel/.config/plasma-workspace/env
mkdir -p /etc/skel/.config/kdedefaults
mkdir -p /etc/skel/.config/systemd/user/plasma-workspace.target.wants
mkdir -p /etc/skel/.config/systemd/user/app-org.kde.krdpserver.service.d
mkdir -p /etc/skel/.config/autostart
mkdir -p /etc/skel/.var/app/org.fcitx.Fcitx5/config/fcitx5/conf
mkdir -p /etc/skel/.local/share/krdpserver
mkdir -p /etc/skel/.local/share/flatpak/db
mkdir -p '/etc/skel/Desktop' '/etc/skel/デスクトップ'

# KWin: set Fcitx5 as input method
cat > /etc/skel/.config/kwinrc << 'KWINRC_EOF'
[Wayland]
InputMethod=/var/lib/flatpak/exports/share/applications/org.fcitx.Fcitx5.desktop
KWINRC_EOF

# Fcitx5 environment variables
cat > /etc/skel/.config/plasma-workspace/env/fcitx5.sh << 'FCITX5ENV_EOF'
#!/bin/sh
export GTK_IM_MODULE=fcitx
export QT_IM_MODULE=fcitx
export XMODIFIERS=@im=fcitx
FCITX5ENV_EOF
chmod +x /etc/skel/.config/plasma-workspace/env/fcitx5.sh

# Fcitx5 profile: Mozc as default input method
cat > /etc/skel/.var/app/org.fcitx.Fcitx5/config/fcitx5/profile << 'FCITX5PROFILE_EOF'
[Groups/0]
Name=Default
Default Layout=us
DefaultIM=mozc

[Groups/0/Items/0]
Name=keyboard-us
Layout=

[Groups/0/Items/1]
Name=mozc
Layout=

[GroupOrder]
0=Default
FCITX5PROFILE_EOF

# Hide KDE welcome center
cat > /etc/skel/.config/plasma-welcomerc << 'PLASMAWELCOME_EOF'
[General]
LastSeenVersion=999.999.999
PLASMAWELCOME_EOF

# Hide Fcitx5 Wayland diagnostic popup
cat > /etc/skel/.var/app/org.fcitx.Fcitx5/config/fcitx5/conf/notifications.conf << 'FCITX5NOTIFY_EOF'
[HiddenNotifications]
0=wayland-diagnose-kde
FCITX5NOTIFY_EOF

# Breeze Dark theme (kdedefaults)
cat > /etc/skel/.config/kdedefaults/kdeglobals << 'KDEDEFAULTSGLOBAL_EOF'
[General]
ColorScheme=BreezeDark

[Icons]
Theme=breeze-dark

[KDE]
widgetStyle=Breeze
KDEDEFAULTSGLOBAL_EOF

cat > /etc/skel/.config/kdedefaults/ksplashrc << 'KSPLASHRC_EOF'
[KSplash]
Engine=KSplashQML
Theme=org.kde.breezedark.desktop
KSPLASHRC_EOF

printf 'org.kde.breezedark.desktop\n' > /etc/skel/.config/kdedefaults/package

